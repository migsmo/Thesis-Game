  m_Name: TutorialScene1
  m_EditorClassIdentifier: 
  sentences:
  - text: Welcome, Atlas. Today, we begin the journey to become a Titan Handler.
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
  - text: I'm ready, Luna.
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
  - text: Excellent. Let's start with the basics.
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: "You need to understand that controlling a Titan is about harmony between
      body and mind. Now get in the Titan and I\u2019ll explain to you the interface."
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions: []
  background: {fileID: 21300000, guid: b8b0a888a1d724b7cacc1a876af51baa, type: 3}
  nextScene: {fileID: 11400000, guid: 2b96f284e43a04d6981805ceead6c1be, type: 2}
