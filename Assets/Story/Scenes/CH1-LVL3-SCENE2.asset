  m_EditorClassIdentifier: 
  sentences:
  - text: We're holding them back, Hyperion. For our city!
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: Excellent work, Atlas. Your performance today proves you're ready for the
      challenges ahead.
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: 'This was just a taste of what''s to come, Atlas. The rogue beasts are
      growing stronger and more numerous. '
    speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
  - text: We'll be ready for them, won't we, Hyperion?
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
