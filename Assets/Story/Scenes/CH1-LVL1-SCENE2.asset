  m_Name: CH1-LVL1-SCENE2
  m_EditorClassIdentifier: 
  sentences:
  - text: 'Good job Atlas! You easily broke the record of the best handlers of the
      past. I really can expect great things from you.  '
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
  - text: "Don\u2019t let this go to your head though, arrogance can make you careless
      on the battlefield. One less handler for our city, Olympia, is one step closer
      for those rogue beasts. "
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions: []
  - text: I understand the stakes, Luna. I won't let our city down.
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: The level ends as Atlas takes his first step on the journey of being a
      Titan Handler, ready to face the impending challenges.
    speaker: {fileID: 11400000, guid: 651f8c6407d06472c820459941e2ea71, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 1
      actionType: 3
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 3
      coords: {x: -632, y: -632}
      moveSpeed: 0
  background: {fileID: 21300000, guid: b8b0a888a1d724b7cacc1a876af51baa, type: 3}
