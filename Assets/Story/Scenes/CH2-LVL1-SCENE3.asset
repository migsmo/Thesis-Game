  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 500ef08f4cfac4121a17369cfd788261, type: 3}
  m_Name: CH2-LVL1-SCENE3
  m_EditorClassIdentifier: 
  sentences:
  - text: I... I saw something. A vision.
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: 'A vision? What did you see, Atlas? '
    speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
  - text: 'Two beings... ancient, celestial. They were fighting. And then there was
      a fall... a skyfall... '
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
  - text: 'That''s... fascinating, Atlas. Your connection with Hyperion could be
      revealing something about the celestial fragments. '
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
  - text: ' It''s just a theory, but the celestial fragments could hold the memories
      of their origins. Through your bond with Hyperion, you might be accessing those
      memories. '
    speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
  - text: In the echoing chambers of the training bay, the whispers of the past have
      begun to speak. With celestial fragments, rogue beasts, and now, Atlas' unsettling
      visions, a tapestry of history and destiny starts to unfold. The true depth
      of their connection remains veiled, awaiting discovery.
    speaker: {fileID: 11400000, guid: 651f8c6407d06472c820459941e2ea71, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  background: {fileID: 0}
  nextScene: {fileID: 0}
