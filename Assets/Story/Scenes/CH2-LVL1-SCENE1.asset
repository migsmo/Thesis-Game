  m_Script: {fileID: 11500000, guid: 500ef08f4cfac4121a17369cfd788261, type: 3}
  m_Name: CH2-LVL1-SCENE1
  m_EditorClassIdentifier: 
  sentences:
  - text: Atlas, we're seeing an increase in the rogue beasts' activity. Their movements
      are becoming more coordinated, almost as if they're being directed.
    speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
  - text: Directed? By what?
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: 'We''re not sure yet. We''ve detected an extremely powerful rogue beast
      near the city. We believe it could be influencing the others. '
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: And we're to neutralize this beast?
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: ' Correct. The city''s safety is our top priority. Get into hyperion and
      lets run some tests to cover up some of your weaknesses.'
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  background: {fileID: 21300000, guid: b8b0a888a1d724b7cacc1a876af51baa, type: 3}
  nextScene: {fileID: 11400000, guid: fba98676200c74c17a41396b8bdc0b5f, type: 2}
