  m_EditorClassIdentifier: 
  sentences:
  - text: It's done.
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: Olympia remains untouched. We've saved our city.
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: By standing together.
    speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
  - text: The trio gaze back towards Olympia in the distance, the city gleaming under
      the now-breaking storm clouds, a symbol of hope and resilience.
    speaker: {fileID: 11400000, guid: 651f8c6407d06472c820459941e2ea71, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
