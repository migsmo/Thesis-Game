  m_EditorClassIdentifier: 
  sentences:
  - text: We did it... We protected the city. But what is that...?
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: 'That''s no ordinary rogue beast, Atlas. Its behavior, its size... I''ve
      never seen anything like it before. '
    speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: Its presence might explain the sudden attack. Could it be an alpha beast...
      or something worse?
    speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 59764f4eef94842ba9b4f4a26e2e36dd, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 4da1349162b9249a983856943424b454, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 157, y: -146}
      moveSpeed: 0
