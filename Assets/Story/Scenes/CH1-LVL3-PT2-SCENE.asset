  sentences:
  - text: Breathing heavily but victorious, Atlas emerges from Hyperion's cockpit.
      Gaia's voice rings out again
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions: []
  - text: You did it, Atlas. The city-state is safe. This is just the beginning of
      your journey, Atlas. You and Hyperion have proven your potential today.
    speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
  - text: The city-state's residents cheer their new hero, reinforcing Atlas's reputation
      as a promising Titan Handler
    speaker: {fileID: 11400000, guid: 651f8c6407d06472c820459941e2ea71, type: 2}
    actions:
