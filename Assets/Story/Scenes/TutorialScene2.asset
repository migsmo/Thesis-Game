  m_Script: {fileID: 11500000, guid: 500ef08f4cfac4121a17369cfd788261, type: 3}
  m_Name: TutorialScene2
  m_EditorClassIdentifier: 
  sentences:
  - text: Now that i've shown you guys around the campus, I'll show you guys my favourite
      place.
    speaker: {fileID: 11400000, guid: 29aacfb9bef8d44c995b9667a7eae78f, type: 2}
    actions: []
  - text: "This is the Exor Hangar, this is where you\u2019ll be spending most of
      your time in the Acadamy. As you can see behind me, Exors are mechs that uses
      state of the art technology developed by Sigma Corp to fight off the Saizans."
    speaker: {fileID: 11400000, guid: 29aacfb9bef8d44c995b9667a7eae78f, type: 2}
    actions: []
  - text: "Why don\u2019t you hop you all hop in one, so I can show you how it works."
    speaker: {fileID: 11400000, guid: 29aacfb9bef8d44c995b9667a7eae78f, type: 2}
    actions: []
