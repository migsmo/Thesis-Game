  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 500ef08f4cfac4121a17369cfd788261, type: 3}
  m_Name: CH1-LVL3-PT1-SCENE
  m_EditorClassIdentifier: 
  sentences:
  - text: Atlas, this isn't a simulation anymore. This is real, and our city needs
      you.
    speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
  - text: I understand, Gaia. Hyperion and I are ready.
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: Atlas climbs into Hyperion's cockpit, the bond between them palpable. The
      beast roars in the distance, its threats echoing through the city walls
    speaker: {fileID: 11400000, guid: 651f8c6407d06472c820459941e2ea71, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
      spriteIndex: 1
      actionType: 3
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 3
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: 'Every exercise you''ve practiced, every move you''ve learned...it all
      comes down to this, Atlas. Remember, the city-state is relying on you and Hyperion.  '
    speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
  - text: We won't let them down. Let's do this, Hyperion.
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: Atlas steels his heart and is filled with determination to defend the city
      against the seemingly endless horde of rogue monsters.
    speaker: {fileID: 11400000, guid: 651f8c6407d06472c820459941e2ea71, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 0e33de4a91d1c40c8b01f97a04e983c8, type: 2}
      spriteIndex: 1
      actionType: 3
      coords: {x: 557, y: -146}
      moveSpeed: 0
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 3
      coords: {x: -632, y: -132}
      moveSpeed: 0
  background: {fileID: 21300000, guid: 83de200c1b6eb56419b0f4c4e86f3251, type: 3}
  nextScene: {fileID: 11400000, guid: dd69f7ed45eb348239533cc6c4f00efc, type: 2}
