  m_EditorClassIdentifier: 
  sentences:
  - text: Victory, for now. But the battle has only unveiled a fragment of the looming
      storm.
    speaker: {fileID: 11400000, guid: 651f8c6407d06472c820459941e2ea71, type: 2}
    actions: []
  - text: That... That was just the beginning. The real fight is yet to come.
    speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  - text: As the level ends, a new determination solidifies within Atlas and his
      comrades. They're up against a cosmic entity, but they will do whatever it
      takes to protect their city-state and its celestial fragments.
    speaker: {fileID: 11400000, guid: 651f8c6407d06472c820459941e2ea71, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 238185b8d5a334aa2970362b639adf6c, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: -632, y: -132}
      moveSpeed: 0
  background: {fileID: 21300000, guid: 8e873496196de43ff833d17fa6cb4894, type: 3}
  nextScene: {fileID: 0}
